# Copy to `.env` (it is gitignored). `npm run dev` loads it automatically.

# Port the API listens on. The extension's default VITE_API_URL is http://localhost:5080.
PORT=5080

# Postgres. Local default matches compose.yaml. For Neon, append ?sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/watchparty

# Secret that signs access tokens. At least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Comma-separated origins allowed to call the API from a browser page (the web
# dashboard). The extension's service worker uses host permissions, not CORS.
CORS_ORIGINS=http://localhost:5174

# Set to the number of reverse proxies in front of the API (e.g. 1 behind Caddy),
# so rate limits see the real client address. 0 when exposed directly.
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Error tracking. Leave empty to disable Sentry.
SENTRY_DSN=

# Traces and metrics over OTLP/HTTP. Leave the endpoint empty to disable OpenTelemetry.
# Example (Grafana Cloud): https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=
# Auth for the backend, e.g. Authorization=Basic <base64 instanceId:token>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=watchparty-api
