# Copy to .env next to docker-compose.yml (on the VPS: ~/watchparty/.env). Never commit it.

# Postgres connection string (Neon: append ?sslmode=require).
DATABASE_URL=

# Signs login tokens. 32+ characters: openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=

# Comma-separated origins allowed to call the API from a browser page (the web dashboard).
CORS_ORIGINS=

# Optional
LOG_LEVEL=info
SENTRY_DSN=
# Traces and metrics over OTLP/HTTP, e.g. https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Host port on 127.0.0.1 that your reverse proxy forwards to.
WATCHPARTY_PORT=8081
